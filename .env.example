# ─── LLM Provider ───────────────────────────────────────────
# Supported: ollama, openai, anthropic
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-oss:120b-cloud

# ─── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Speech-to-Text (for Telegram voice messages) ──────────
# Supports any OpenAI-compatible Whisper API endpoint:
#   Groq (free):  https://api.groq.com/openai/v1/audio/transcriptions
#   OpenAI:       https://api.openai.com/v1/audio/transcriptions
#   Local:        http://localhost:8080/v1/audio/transcriptions
STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
